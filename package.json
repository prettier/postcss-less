{
  "name": "postcss-less",
  "version": "6.0.0",
  "type": "module",
  "description": "LESS parser for PostCSS",
  "license": "MIT",
  "repository": "prettier/postcss-less",
  "author": "Denys Kniazevych <webschik@gmail.com>",
  "maintainer": "Andrew Powell <andrew@shellscape.org>",
  "homepage": "https://github.com/prettier/postcss-less",
  "bugs": "https://github.com/prettier/postcss-less/issues",
  "engines": {
    "node": ">=22"
  },
  "exports": "./lib/index.js",
  "scripts": {
    "fix": "run-p --continue-on-error \"fix:*\"",
    "fix:eslint": "yarn lint:eslint --fix",
    "fix:prettier": "prettier . --write",
    "lint": "run-p --continue-on-error \"lint:*\"",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier . --check",
    "test": "ava",
    "test-coverage": "c8 yarn test",
    "release": "release-it"
  },
  "files": [
    "lib"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "ava": "8.2.0",
    "c8": "12.0.0",
    "cheerio": "1.2.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "is-absolute-url": "5.0.0",
    "less": "4.9.1",
    "npm-run-all2": "9.0.4",
    "outdent": "0.8.0",
    "postcss": "8.5.32",
    "postcss-parser-tests": "8.10.0",
    "prettier": "3.9.10",
    "release-it": "21.1.1",
    "url-join": "6.0.0"
  },
  "peerDependencies": {
    "postcss": "^8.5.32"
  },
  "keywords": [
    "css",
    "postcss",
    "postcss-syntax",
    "parser",
    "less"
  ],
  "ava": {
    "files": [
      "!**/fixtures/**",
      "!**/helpers/**"
    ],
    "verbose": true
  },
  "c8": {
    "reporter": [
      "lcov",
      "text"
    ],
    "include": [
      "lib/*.js"
    ],
    "exclude": [
      "lib/client*.js",
      "test/"
    ]
  },
  "packageManager": "yarn@4.18.1",
  "sideEffects": false
}
