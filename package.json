{
  "name": "postcss-less",
  "version": "6.0.0",
  "type": "module",
  "description": "LESS parser for PostCSS",
  "license": "MIT",
  "repository": "shellscape/postcss-less",
  "author": "Denys Kniazevych <webschik@gmail.com>",
  "maintainer": "Andrew Powell <andrew@shellscape.org>",
  "homepage": "https://github.com/shellscape/postcss-less",
  "bugs": "https://github.com/shellscape/postcss-less/issues",
  "main": "lib/index.js",
  "engines": {
    "node": ">=12"
  },
  "scripts": {
    "fix": "run-p --continue-on-error \"fix:*\"",
    "fix:eslint": "yarn lint:eslint --fix",
    "fix:prettier": "prettier . --write",
    "ci:coverage": "nyc npm run test && nyc report --reporter=text-lcov > coverage.lcov",
    "ci:lint": "npm run lint && npm run security",
    "ci:test": "npm run test",
    "lint": "run-p --continue-on-error \"lint:*\"",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier . --check",
    "test": "ava"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "ava": "8.1.1",
    "cheerio": "1.0.0-rc.10",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "is-absolute-url": "3.0.0",
    "less": "4.1.1",
    "node-fetch": "2.6.1",
    "npm-run-all2": "^9.0.4",
    "nyc": "15.1.0",
    "postcss": "8.3.5",
    "postcss-parser-tests": "8.3.5",
    "prettier": "^3.9.10",
    "prettier-plugin-package": "^2.0.0",
    "url-join": "4.0.0"
  },
  "peerDependencies": {
    "postcss": "^8.3.5"
  },
  "keywords": [
    "css",
    "postcss",
    "postcss-syntax",
    "parser",
    "less"
  ],
  "ava": {
    "files": [
      "!**/fixtures/**",
      "!**/helpers/**"
    ],
    "verbose": true
  },
  "nyc": {
    "include": [
      "lib/*.js"
    ],
    "exclude": [
      "lib/client*.js",
      "test/"
    ]
  },
  "packageManager": "yarn@4.18.1"
}
