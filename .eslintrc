{
  "extends": "shellscape",
  "overrides": [
    {
      "files": "test/**/*.js",
      "parserOptions": {
        "sourceType": "module"
      },
      "rules": {
        "import/no-unresolved": "off",
        "import/extensions": "off",
        "import/no-extraneous-dependencies": "off"
      }
    },
    {
      "files": "**/*.js",
      "rules": {
        "prettier/prettier": "off"
      }
    }
  ]
}
